# CityBuddy local environment template.
# Copy this file to backend/.env and put real secret values ONLY in backend/.env.
# backend/.env is ignored by Git and must never be committed.

# --- Database ---
# Production: prefer DATABASE_URL from Render. Local Docker can use the POSTGRES_* fields.
DATABASE_URL=
POSTGRES_USER=citybuddy
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=citybuddy

# --- vLLM production-style inference ---
# VLLM_API_KEY is SECRET. VLLM_BASE_URL is configuration (Quick Tunnel URL may change).
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_PLANNER_MODEL=Qwen/Qwen3-0.6B
VLLM_RESPONSE_MODEL=
VLLM_TIMEOUT_SECONDS=45

# --- Ollama local/development inference ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional separate interactive model endpoints (reuse OLLAMA_BASE_URL when empty).
OLLAMA_PLANNER_BASE_URL=
OLLAMA_RESPONSE_BASE_URL=
OLLAMA_EMBEDDING_BASE_URL=
OLLAMA_PLANNER_MODEL=qwen3:8b
OLLAMA_RESPONSE_MODEL=gemma3:12b-it-qat
OLLAMA_EMBEDDING_MODEL=bge-m3
RAG_ENABLED=true
RAG_EVIDENCE_LIMIT=8
OLLAMA_TIMEOUT_SECONDS=45

# --- Optional LangSmith evaluation tracing ---
# LANGSMITH_API_KEY is SECRET. Tracing remains opt-in in CityBuddy.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=citybuddy-local-evaluation

# --- Background ingestion ---
OLLAMA_INGESTION_MODEL=qwen3:4b
# Leave empty to reuse OLLAMA_BASE_URL locally; set a separate endpoint when needed.
OLLAMA_INGESTION_BASE_URL=
