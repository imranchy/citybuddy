# CityBuddy local environment template.
# Copy this file to backend/.env and put real secret values ONLY in backend/.env.
# backend/.env is ignored by Git and must never be committed.

# --- Database ---
DATABASE_URL=
POSTGRES_USER=citybuddy
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=citybuddy

# --- vLLM inference (required for assistant AI) ---
# VLLM_API_KEY is SECRET. The same application config works with local or remote vLLM.
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_PLANNER_MODEL=Qwen/Qwen3-1.7B
VLLM_RESPONSE_MODEL=
VLLM_TIMEOUT_SECONDS=45

# Optional dedicated vLLM ingestion endpoint. Empty values reuse the main vLLM endpoint/key.
VLLM_INGESTION_MODEL=Qwen/Qwen3-1.7B
VLLM_INGESTION_BASE_URL=
VLLM_INGESTION_API_KEY=

# Optional dedicated vLLM embedding endpoint. Empty values reuse the main vLLM endpoint/key.
VLLM_EMBEDDING_MODEL=BAAI/bge-m3
VLLM_EMBEDDING_BASE_URL=
VLLM_EMBEDDING_API_KEY=
RAG_ENABLED=true
RAG_EVIDENCE_LIMIT=8

# --- Optional LangSmith evaluation tracing ---
# LANGSMITH_API_KEY is SECRET. Tracing remains opt-in in CityBuddy.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=citybuddy-local-evaluation
