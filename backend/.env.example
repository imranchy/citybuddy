POSTGRES_USER=citybuddy
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=citybuddy

OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional separate interactive model endpoints (reuse OLLAMA_BASE_URL when empty).
OLLAMA_PLANNER_BASE_URL=
OLLAMA_RESPONSE_BASE_URL=
OLLAMA_EMBEDDING_BASE_URL=
OLLAMA_PLANNER_MODEL=qwen3:8b
OLLAMA_RESPONSE_MODEL=gemma3:12b-it-qat
OLLAMA_EMBEDDING_MODEL=bge-m3
RAG_ENABLED=true
RAG_EVIDENCE_LIMIT=8
OLLAMA_TIMEOUT_SECONDS=45

# Optional: only synthetic evaluation traces are sent when --langsmith is used.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=citybuddy-local-evaluation

# Optional dedicated background-ingestion inference endpoint/model.
OLLAMA_INGESTION_MODEL=qwen3:4b
# Leave empty to reuse OLLAMA_BASE_URL locally; set a separate endpoint in production.
OLLAMA_INGESTION_BASE_URL=
